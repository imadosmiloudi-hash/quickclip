# Server
PORT=3000
NODE_ENV=development
APP_BASE_URL=http://localhost:3000

# Database (Postgres on Railway; for local/tests use file via PGlite — leave unset in tests)
DATABASE_URL=postgresql://user:password@localhost:5432/quickclip

# Auth
JWT_SECRET=change-me-to-a-long-random-secret
JWT_EXPIRES_IN=7d

# Storage (local filesystem abstraction; S3-compatible fields for later)
STORAGE_DRIVER=local
STORAGE_PATH=./storage
STORAGE_ENDPOINT=
STORAGE_BUCKET=quickclip
STORAGE_ACCESS_KEY=
STORAGE_SECRET_KEY=
STORAGE_REGION=auto

# Limits
RATE_LIMIT_WINDOW_MS=900000
RATE_LIMIT_MAX=200
MAX_UPLOAD_BYTES=52428800
